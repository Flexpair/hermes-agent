+
+  const write = (payload: Parameters<typeof parseUiPreferencesWrite>[0]) => {
+    const request = parseUiPreferencesWrite(payload)
+
+    const operation = (async () => {
+      if (!request.seed) { await gate }
+
+      return writeUiPreferences(file, request)
