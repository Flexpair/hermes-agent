+const PROFILES = 'hermes-desktop-profile-modes-v1'
+const BASELINE = 'hermes-desktop-flexpair-palette-baseline-v1'
+const writeOperations: Promise<UiPreferencesSnapshot>[] = []
+
+const advance = async () => {
