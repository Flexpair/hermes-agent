diff --git a/scripts/install.sh b/scripts/install.sh
index 502c882fda8350ad49b13cad87569bfb932e9dec..54f22d5e117a609869228e7a1f2a8e490f1e2403 100755
--- a/scripts/install.sh
+++ b/scripts/install.sh
@@ -21,5 +21,5 @@ set -u
 export UV_NO_CONFIG=1
 
-REPO_URL="${HERMES_REPO_URL:-https://github.com/NousResearch/hermes-agent.git}"
+REPO_URL="${HERMES_REPO_URL:-https://github.com/Flexpair/hermes-agent.git}"
 BRANCH="main"
 INSTALL_COMMIT=""
@@ -731,4 +731,13 @@ stage_products() {
         || fail "app products or command publication failed"
     wire_shell_path
+    # Distribution defaults belong in the installer, not the desktop core.
+    run_logged "Installing Flexpair color palette" \
+        "$INSTALL_DIR/.hermes/bin/hermes" plugins install \
+        https://github.com/Flexpair/hermes-plugins/tree/main/flexpair-color-palette \
+        --ref bbff250954d28f992668e227cdb59301befe8717 --enable \
+        || fail "Flexpair color palette installation failed"
+    run_logged "Enabling Flexpair color palette" \
+        "$INSTALL_DIR/.hermes/bin/hermes" plugins enable flexpair-color-palette \
+        || fail "Flexpair color palette activation failed"
     log_success "app products and hermes command ready"
 }
